# ─────────────────────────────────────────────────────────────
#  Kuvert – Konfiguration (nach .env kopieren und anpassen)
# ─────────────────────────────────────────────────────────────

# Öffentliche URL, unter der Kuvert erreichbar ist (ohne / am Ende).
# Wichtig für OAuth-Redirects (Microsoft/Google) und sichere Cookies (https).
PUBLIC_URL=http://localhost:8080

# Geheimer Schlüssel für Sitzungen und die Verschlüsselung gespeicherter
# Zugangsdaten. Leer = wird beim ersten Start erzeugt und in /data abgelegt.
# Erzeugen z. B. mit:  openssl rand -base64 48
APP_SECRET=

# Selbstregistrierung weiterer Benutzer erlauben (der erste Benutzer wird Admin)
ALLOW_REGISTRATION=false

# Abfrageintervall für neue Mails in Sekunden (IMAP nutzt zusätzlich IDLE/Push)
POLL_INTERVAL=60
# Gmail-Quota je Nutzer und Minute (Google-Standard 15.000). Suchindex & Polling nutzen höchstens
# 40 % davon. Niedriger setzen, wenn mehrere Instanzen dasselbe Google-OAuth-Projekt verwenden.
GMAIL_QUOTA_PER_MIN=15000
# Maximale Größe einzelner Uploads/Anhänge in MB
UPLOAD_MAX_MB=35
LOG_LEVEL=info

# Hinweis: Microsoft-, Google- und KI-Einstellungen können auch im Admin-Bereich
# (Admin → Dienste & Anmeldung) gepflegt werden. Die Werte hier dienen dann als Vorgabe.

# ───────── Microsoft 365 (Azure App-Registrierung) ─────────
# Redirect-URI in Azure:  <PUBLIC_URL>/api/oauth/callback   (Plattform "Web")
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "common" (alle Tenants + private Konten), "organizations" oder eine Tenant-ID
MS_TENANT=common

# ───────── Google Workspace / Gmail (Google Cloud OAuth-Client) ─────────
# Autorisierte Weiterleitungs-URI:  <PUBLIC_URL>/api/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: API-Schlüssel (Places API New) für die Ortssuche im Termin-Dialog
GOOGLE_PLACES_API_KEY=

# ───────── KI-Assistent ─────────
AI_ENABLED=true
# "ollama" oder "openai" (OpenAI-kompatibel: LM Studio, vLLM, LocalAI, …)
AI_BACKEND=ollama
AI_BASE_URL=http://ollama:11434
AI_MODEL=llama3.1:8b
AI_API_KEY=
AI_TEMPERATURE=0.4
# KI-Triage (Priorität/Kategorie für neue Mails, pro Benutzer einschaltbar):
# gleichzeitige Einordnungen und Aufbewahrung der Ergebnisse in Tagen
AI_TRIAGE_CONCURRENCY=1
AI_TRIAGE_RETENTION_DAYS=180

# ───────── Suchindex (Meilisearch) ─────────
# Pflicht für den mitgelieferten Meilisearch-Container. Erzeugen mit:  openssl rand -hex 32
MEILI_MASTER_KEY=
# Wird im docker-compose.yml automatisch auf http://meilisearch:7700 gesetzt.
# Leer lassen (oder SEARCH_ENABLED=false), um ohne Index nur live beim Anbieter zu suchen.
# MEILI_URL=
SEARCH_INDEX_BODIES=true
# Nur Nachrichten der letzten n Tage indizieren (0 = alle)
SEARCH_MAX_AGE_DAYS=0
SEARCH_INCLUDE_TRASH=false
SEARCH_SYNC_INTERVAL=5

# ───────── Web Push (optional) ─────────
# Leer = Schlüssel werden automatisch erzeugt und gespeichert.
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ───────── Integrationen (optional, auch im Admin-Bereich einstellbar) ─────────
# mailcow: Instanz beim ersten Start automatisch anlegen (Read-Write-API-Key, Kuvert-IP in mailcow freischalten)
MAILCOW_URL=
MAILCOW_API_KEY=
MAILCOW_NAME=mailcow
# Mail-Archiver: Standard-URL (Benutzer hinterlegen ihren persönlichen API-Schlüssel selbst)
MAILARCHIVER_URL=
# 3CX (V20, Call Control API): Adresse, Client-ID und API-Schlüssel der API-Anwendung (3CX → Integrationen → API)
THREECX_URL=
THREECX_CLIENT_ID=
THREECX_API_KEY=
# Anrufe im Team-Chat (LiveKit, docker compose --profile meet up -d) – auch im Admin-Bereich unter „Anrufe“ einstellbar.
# Geheimnis mit mindestens 32 Zeichen, z. B. openssl rand -hex 32
# LIVEKIT_URL=http://livekit:7880
# LIVEKIT_API_KEY=kuvert
# LIVEKIT_API_SECRET=
# Eigene Adresse für Browser (leer = über Kuvert unter /api/meet/lk)
# LIVEKIT_PUBLIC_URL=
# Chat: Anbindung von Mattermost/Nextcloud Talk (pro Benutzer unter Einstellungen → Chat); false = abschalten
CHAT_BRIDGES=true

# ───────── Module ─────────
# Nur bestimmte Module laden (leer = alle), z. B.: KUVERT_MODULES=imap,dav,ai,smime,notifications
KUVERT_MODULES=
# Einzelne Module abschalten, z. B.: KUVERT_DISABLED_MODULES=google
KUVERT_DISABLED_MODULES=
